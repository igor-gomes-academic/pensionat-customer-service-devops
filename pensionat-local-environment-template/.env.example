# Default configuration for the shared Docker Compose environment.
# Copy this file with docker-compose.yaml to the parent directory, rename it to .env and provide values for the empty password variables.

COMPOSE_PROJECT_NAME=pensionat
TZ=Europe/Stockholm

FRONTEND_HOST_PORT=3000
BOOKING_SERVICE_HOST_PORT=8080
CUSTOMER_SERVICE_HOST_PORT=8081

BOOKING_DB_HOST_PORT=3308
BOOKING_DB_NAME=pensionat_booking_db
BOOKING_DB_USERNAME=pensionat_booking
BOOKING_DB_PASSWORD=
BOOKING_DB_ROOT_PASSWORD=

CUSTOMER_DB_HOST_PORT=3307
CUSTOMER_DB_NAME=pensionat_customer_db
CUSTOMER_DB_USERNAME=pensionat_customer
CUSTOMER_DB_PASSWORD=
CUSTOMER_DB_ROOT_PASSWORD=
